###
### Bat
###
# bat is packaged as batcat on Debian, so prefer a real bat where both exist
for _bat in batcat bat; do
  if command -v "${_bat}" >/dev/null 2>&1; then
    alias cat="${_bat}"

    if command -v fzf >/dev/null 2>&1; then
      alias fzf="fzf --preview '${_bat} --style=numbers --color=always --line-range :500 {}'"
    fi
  fi
done
unset _bat
