###
### Git
###
function git_default_branch() {
  { git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
    || { git remote set-head origin --auto >/dev/null 2>&1 && git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null; }; } \
    | sed 's@^refs/remotes/origin/@@' | head -n1
}

function main_worktree_path() {
  git worktree list --porcelain | head -n1 | sed 's/^worktree //'
}

function within_worktree() {
  [ "$(git rev-parse --show-toplevel)" != "$(main_worktree_path)" ]
}

# Path of the worktree holding a given branch, if there is one
function worktree_path_for_branch() {
  local branch=$1
  test -n "${branch}" || return 1

  git worktree list --porcelain | awk -v want="branch refs/heads/${branch}" '
    /^worktree / { path = substr($0, 10) }
    $0 == want   { print path; exit }
  '
}

# git checkout and pull
function gcm() {
  git switch $(git_default_branch) && git pull
}

# Automatic rebase with default branch
function grb() {
  local default=$(git_default_branch)

  if within_worktree; then
    git fetch origin "${default}" && git rebase origin/"${default}"
  else
    gcm && git switch - && git rebase origin/"${default}"
  fi
}

# Interactive branch viewer
function gbr() {
  git for-each-ref refs/heads --format='%(refname)' --sort='-committerdate' $@ | sed 's/refs\/heads\///g' | fzf --preview='git log --color=always --oneline {} |head -20' || true
}

# Git switch that recognises worktrees
function gsw() {
  # Not named "path": zsh binds that to $PATH
  local worktree=$(worktree_path_for_branch "$1")

  if test -n "${worktree}"; then
    cd "${worktree}" || return 1
  elif test "$1" = "-"; then
    # @{-1} is per-worktree, so it is empty if we arrived here by changing directory
    git switch - 2>/dev/null || cd -
  else
    git switch "$@"
  fi
}

# Interactive branch selector
function gsl() {
  local branch=$(gbr)
  test -n "${branch}" || return

  gsw "${branch}" $@
}

# Interactive worktree selector
function gwt() {
  local selected
  selected=$(git worktree list | fzf --preview='git -C {1} log --color=always --oneline -20' | awk '{print $1}') || return
  test -n "${selected}" || return

  if command -v z >/dev/null 2>&1; then
    z "${selected}"
  else
    cd "${selected}" || return 1
  fi
}

# Interactive commit sha selector, prints the chosen sha
function glo() {
  git log --oneline --format=format:%H $@ | fzf --preview='git show --color=always {}' || true
}

# Interactive fixup selector
function gfu() {
  local sha=$(glo)
  test -n "${sha}" || return

  git fixup "${sha}" $@
}

# Cherry pick
function gcp() {
  git cherry-pick $@
}

# Move to root of repo
function grt() {
  local root=$(git rev-parse --show-toplevel 2>/dev/null)
  test -n "${root}" || return 1

  if command -v z >/dev/null 2>&1; then
    z "${root}"
  else
    cd "${root}" || return 1
  fi
}

alias gco="git checkout"

alias commit="git rev-parse HEAD"
alias branch="git rev-parse --abbrev-ref HEAD"

