{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "inherit"
  },
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(bundle:*)",
      "Bash(cat:*)",
      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(grep:*)",
      "Bash(hcl2json:*)",
      "Bash(jq:*)",
      "Bash(jsonnet:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mise:*)",
      "Bash(npm:*)",
      "Bash(python3:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(shellcheck:*)",
      "Bash(wc:*)",
      "WebFetch(domain:*)",
      "WebSearch"
    ],
    "additionalDirectories": [
      "~/ably",
      "~/claude",
      "~/surminus"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "ably-skills@ably-os": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ably-os": {
      "source": {
        "source": "git",
        "url": "https://github.com/ably/ably-os.git"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
